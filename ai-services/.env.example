APP_NAME=TeleSale AI Service
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh

LLM_API_KEY=replace-with-openai-api-key
LLM_MODEL=gpt-6-luna
LANGMEM_MODEL=
LANGMEM_MAX_TOKENS=1024
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=256

AGENT_MAX_TOOL_CALLS=8
AGENT_PROMPT_HISTORY_TURNS=6
AGENT_GUARDRAILS_ENABLED=true
MEMORY_MAX_EPISODES=5

LANGFUSE_ENABLED=false
LANGFUSE_PROMPTS_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false

AI_INTERNAL_TOKEN=replace-with-same-random-token-as-backend
MCP_INTERNAL_TOKEN=replace-with-another-random-token
MCP_CATALOG_URL=http://127.0.0.1:8011/mcp
MCP_ORDER_URL=http://127.0.0.1:8012/mcp
MCP_MEMORY_URL=http://127.0.0.1:8013/mcp
MCP_HOST=127.0.0.1
MCP_CATALOG_PORT=8011
MCP_ORDER_PORT=8012
MCP_MEMORY_PORT=8013

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
MEMORY_DB_POOL_MIN_SIZE=1
MEMORY_DB_POOL_MAX_SIZE=5


KNOWLEDGE_ENABLED=false

MCP_KNOWLEDGE_URL=http://127.0.0.1:8014/mcp
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
