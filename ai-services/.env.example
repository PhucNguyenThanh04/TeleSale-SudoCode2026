APP_NAME=TeleSale AI Service
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
# INFO shows redacted model/tool I/O in the AI service and all three MCP servers.
TIMEZONE=Asia/Ho_Chi_Minh

# Direct Ollama Cloud API; keep the real key only in ai-services/.env.
LLM_API_KEY=replace-with-ollama-api-key
LLM_MODEL=gemma4:31b
# LLM_SEED=7
LANGMEM_MODE=enabled
LANGMEM_MODEL=
LANGMEM_MAX_TOKENS=1024
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=256

# Agent budget and long-term context. Keep >=3 calls for stock -> quote -> order.
AGENT_MAX_TOOL_CALLS=3
# MCP memory currently returns at most 12 recent turns (allowed: 1-12).
AGENT_PROMPT_HISTORY_TURNS=6
# Set false for raw Deep Agent reply testing; production answer checks are on by default.
AGENT_GUARDRAILS_ENABLED=true
AGENT_KIND=deep
# Legacy extraction is disabled when LangMem is the primary memory path.
FACT_EXTRACTION_MODE=off
MEMORY_MAX_EPISODES=5
MEMORY_SUMMARY_TURNS=3
MEMORY_SUMMARY_MAX_CHARS=800

# Langfuse Cloud tracing. Use the base URL for your project's region.
# No customer message, model response or tool payload is exported.
LANGFUSE_ENABLED=false
# Development/test only: include prompts, model replies and tool payloads in Cloud traces.
# Do not use this setting with real customer data.
LANGFUSE_CAPTURE_CONTENT=false
# Optional policy RAG. Load the same local embedding model used by dataloader_offline.
# POLICY_RAG_ENABLED=false
# QDRANT_URL=http://127.0.0.1:6333
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The host AI API calls MCP ports; only MCP containers hold PostgreSQL credentials.
AI_INTERNAL_TOKEN=replace-with-same-random-token-as-backend
MCP_INTERNAL_TOKEN=replace-with-another-random-token
MCP_CATALOG_URL=http://127.0.0.1:8011/mcp
MCP_ORDER_URL=http://127.0.0.1:8012/mcp
MCP_MEMORY_URL=http://127.0.0.1:8013/mcp
MCP_HOST=127.0.0.1
MCP_CATALOG_PORT=8011
MCP_ORDER_PORT=8012
MCP_MEMORY_PORT=8013

# MCP PostgreSQL connection pools. SQLAlchemy serves catalog/order; asyncpg serves memory.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
MEMORY_DB_POOL_MIN_SIZE=1
MEMORY_DB_POOL_MAX_SIZE=5

# For local MCP processes only. Compose injects role-specific values and secret-file paths.
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/telesale
# MCP_DB_HOST=127.0.0.1
# MCP_DB_PORT=5432
# MCP_DB_NAME=telesale
# MCP_DB_USER=mcp_catalog
# MCP_DB_PASSWORD_FILE=/absolute/path/to/password-file
# MCP_INTERNAL_TOKEN_FILE=/absolute/path/to/token-file
