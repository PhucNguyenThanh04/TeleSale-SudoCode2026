# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=5 PIP_RESUME_RETRIES=5 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /service
COPY requirements.txt requirements-knowledge.txt ./
RUN --mount=type=cache,id=ai-services-pip-py312-cpu,target=/root/.cache/pip,sharing=locked \
    python -m pip install --upgrade pip==25.2 \
    && python -m pip install -r requirements.txt -r requirements-knowledge.txt
# Includes only the pinned CPU tokenizer asset, never model weights or credentials.
COPY app ./app
CMD ["python", "-m", "app.mcp_servers.mcp_knowledge.server"]
