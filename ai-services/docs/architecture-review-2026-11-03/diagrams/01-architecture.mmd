flowchart TB
    backend["Backend tin cậy<br/>Ranh giới ngoài phạm vi"]
    api["FastAPI :8001<br/>POST /v1/chat/turns"]
    runtime["AgentHarnessRuntime<br/>Lock · identity · cache"]
    graph["Outer LangGraph<br/>5 node cho mỗi lượt"]
    model["ChatOllama<br/>Model từ cấu hình"]
    agent["Deep hoặc ReAct<br/>BusinessOnlyMiddleware"]
    gateway["MCP Gateway<br/>Trusted context + token"]
    obs["Langfuse tùy chọn<br/>Trace / managed prompts"]
    catalog["mcp-catalog :8011<br/>CRM · catalog · stock · quote"]
    order["mcp-order :8012<br/>Order · callback · handoff"]
    memory["mcp-memory :8013<br/>Context / commit_turn"]
    policy["mcp-knowledge :8014<br/>policy.search · hybrid evidence"]
    source["PostgreSQL btc_source<br/>Nguồn BTC được import"]
    commerce["PostgreSQL runtime<br/>Đơn / lịch / handoff"]
    turns["PostgreSQL runtime<br/>Turns / jobs / order links"]
    worker["LangMem worker<br/>Extract + admission"]
    store["AsyncPostgresStore<br/>Facts / episodes trong runtime"]
    ks["PostgreSQL knowledge<br/>Snapshot · release · revocation"]
    qi["Qdrant index<br/>Dense + sparse / RRF"]
    enc["BGE-M3 local / CUDA<br/>Một encoder worker"]
    backend -->|"HTTP + token"| api
    api -->|"chat()"| runtime
    runtime -->|"ainvoke"| graph
    graph -->|"run_agent"| agent
    agent -->|"model I/O"| model
    agent -->|"business tools"| gateway
    graph -->|"context / persist"| gateway
    graph -.->|"callbacks"| obs
    gateway -->|"HTTP MCP"| catalog
    gateway -->|"HTTP MCP"| order
    gateway -->|"HTTP MCP"| memory
    catalog -->|"đọc"| source
    catalog -->|"đọc đơn"| commerce
    order -->|"ghi nghiệp vụ"| commerce
    memory -->|"transaction"| turns
    turns -->|"lease job"| worker
    worker -->|"accepted revisions"| store
    memory -->|"đọc memory"| store
    gateway -->|"HTTP MCP"| policy
    policy -->|"authoritative content"| ks
    policy -->|"rank IDs / hashes"| qi
    policy -->|"query vectors"| enc
