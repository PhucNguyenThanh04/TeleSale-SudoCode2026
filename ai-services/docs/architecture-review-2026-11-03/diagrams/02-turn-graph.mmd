flowchart TB
    req["Request + token<br/>Session / message ID"]
    rt["Runtime<br/>Pin release · identity · lock"]
    cached["Response đã cache<br/>Nếu key trùng"]
    a["accept<br/>Mask text · reset counters"]
    c["retrieve_context<br/>Memory · refresh · brief"]
    r["run_agent<br/>Deep / ReAct"]
    v["verify<br/>Grounding luôn chạy"]
    blocked["Memory lỗi / erasure<br/>Thông báo / handoff"]
    handoff["Yêu cầu gặp người<br/>Gọi handoff trực tiếp"]
    recover["Draft không hợp lệ<br/>Safe reply hoặc fallback"]
    p["persist<br/>Commit masked turn"]
    fail["Commit lỗi<br/>Request thất bại để retry"]
    out["Response + cache state<br/>Text · brief · handoff"]
    req -->|"validate"| rt
    rt -->|"cache hit"| cached
    rt -->|"identity đã resolve"| a
    a --> c
    c -->|"context"| r
    r -->|"draft"| v
    r -->|"nhánh sớm"| blocked
    r -->|"nhánh sớm"| handoff
    v -->|"reject"| recover
    v -->|"verified text"| p
    recover -->|"safe text"| p
    p -->|"write thất bại"| fail
    p -->|"commit OK / blocked skip"| out
    class req external
    class rt core
    class cached optional
    class a core
    class c core
    class r core
    class v core
    class blocked optional
    class handoff optional
    class recover optional
    class p core
    class fail pending
    class out core
