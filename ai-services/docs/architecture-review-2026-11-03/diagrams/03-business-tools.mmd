flowchart TB
    prompt["Prompt + history + facts<br/>Đúng vai customer / agent"]
    llm["Deep hoặc ReAct<br/>Chọn tool / tạo draft"]
    mw["BusinessOnlyMiddleware<br/>Chỉ business tools"]
    pol["BusinessTools + policy<br/>SKU · identity · preconditions"]
    draft["Draft → verify<br/>Không còn tool call"]
    result["Observation đã lọc<br/>Ownership + masking"]
    gate["MCP Gateway<br/>Trusted args · operation key"]
    cat["mcp-catalog<br/>catalog.search<br/>inventory.check<br/>pricing.get_quote"]
    ord["mcp-order<br/>order.create/update/status<br/>schedule.callback<br/>handoff.transfer"]
    mem["mcp-memory<br/>memory.read/write<br/>Harness gọi trực tiếp"]
    rag["mcp-knowledge<br/>policy.search<br/>Signed context + pinned release"]
    sql["Handler → service → repo<br/>Schema + business rules<br/>PostgreSQL transaction"]
    budget["Business tool budget<br/>Cache đọc trong lượt<br/>Không gồm mọi I/O của turn"]
    kg["PostgreSQL + Qdrant<br/>Nguồn có thẩm quyền<br/>Index dense / sparse"]
    prompt --> llm
    llm -->|"tool call"| mw
    mw -->|"allowlist"| pol
    pol -->|"chuẩn hóa / budget"| gate
    gate -->|"routing"| cat
    gate -->|"routing"| ord
    gate -->|"harness I/O"| mem
    gate -->|"routing knowledge"| rag
    cat --> sql
    ord --> sql
    mem --> sql
    sql -->|"kết quả"| result
    result -->|"vòng lặp"| llm
    llm -->|"final"| draft
    pol -->|"giới hạn"| budget
    rag -->|"retrieval / validate"| kg
    class prompt core
    class llm core
    class mw core
    class pol core
    class draft core
    class result core
    class gate core
    class cat service
    class ord service
    class mem service
    class rag service
    class sql data
    class budget optional
    class kg data
    classDef core fill:#e8f1ff,stroke:#3875bc,color:#182f46
    classDef external fill:#f1f3f5,stroke:#64748b,color:#182f46
    classDef service fill:#e1f5ef,stroke:#22836c,color:#182f46
    classDef data fill:#f1eaff,stroke:#8260b0,color:#182f46
    classDef optional fill:#fff5d6,stroke:#b18b25,color:#182f46
    classDef pending fill:#fff0ed,stroke:#be6b5a,color:#182f46
