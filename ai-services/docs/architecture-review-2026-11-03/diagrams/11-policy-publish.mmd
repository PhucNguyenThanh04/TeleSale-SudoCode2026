flowchart TB
    src["BTC policy Markdown<br/>Section IDs + metadata<br/>Không lấy đáp án QA"]
    parse["Parse + safe transform<br/>99 mục gốc / 93 serving<br/>Source + content hash"]
    rev["Approved FAQ / aliases<br/>Reviewer duyệt cả test<br/>Nguồn có provenance"]
    snap["Build release / snapshot<br/>Manifest + config fingerprint<br/>Chưa active"]
    enc["BGE-M3 encode tài liệu<br/>Tác vụ quản trị riêng<br/>Không encode corpus ở startup"]
    index["Qdrant collection / release<br/>Upsert + verify đủ points<br/>Vector schema + hashes"]
    check["Kiểm lại approval / nguồn<br/>Active CAS + revocation<br/>Index / relevance config"]
    ready["Release ready<br/>Snapshot trong PostgreSQL<br/>Collection giữ theo release"]
    act["Reviewer activate<br/>CAS active ID + audit<br/>Rollback / revoke có kiểm tra"]
    start["MCP knowledge startup<br/>Cached model + CUDA<br/>Warmup đúng 3 lượt"]
    verify["Kiểm release / snapshot<br/>Model + config fingerprint<br/>Index đầy đủ"]
    serve["Service ready<br/>Nhận policy.search"]
    fail["Chưa đạt readiness<br/>Không phục vụ / không fallback<br/>Chưa xác minh GPU thật"]
    src --> parse
    parse --> snap
    rev -->|"approved only"| snap
    snap -->|"build ngoài transaction duyệt"| enc
    enc -->|"dense + sparse"| index
    index -->|"verify index"| check
    check -->|"đủ checks"| ready
    ready -->|"activate riêng"| act
    start -->|"encoder ready"| verify
    act -->|"active release"| verify
    verify -->|"startup checks đạt"| serve
    verify -->|"checks lỗi"| fail
    class src external
    class parse core
    class rev external
    class snap data
    class enc service
    class index data
    class check core
    class ready data
    class act external
    class start service
    class verify core
    class serve service
    class fail pending
    classDef core fill:#e8f1ff,stroke:#3875bc,color:#182f46
    classDef external fill:#f1f3f5,stroke:#64748b,color:#182f46
    classDef service fill:#e1f5ef,stroke:#22836c,color:#182f46
    classDef data fill:#f1eaff,stroke:#8260b0,color:#182f46
    classDef optional fill:#fff5d6,stroke:#b18b25,color:#182f46
