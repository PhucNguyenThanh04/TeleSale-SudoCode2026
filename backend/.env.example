APP_NAME=TeleSale-SudoCode2026
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/telesale
REDIS_URL=redis://127.0.0.1:6379/0
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=30
AI_INTERNAL_TOKEN=replace-with-same-random-token-as-ai-services
BTC_DATA_DIR=../BTC-Data-Vong1-TEAMS
CORS_ORIGINS=[]

# Standalone demo gateway: app.voice_main:app (PostgreSQL and demo login required).
# Set AI_SERVICE_TIMEOUT_SECONDS=120 for the voice demo if the agent needs longer.
SPEECH_HTTP_URL=http://127.0.0.1:18110
SPEECH_LISTEN_URL=ws://127.0.0.1:18110/v1/speech/listen
SPEECH_VOICE=Trúc Ly
SPEECH_CONNECT_TIMEOUT_SECONDS=10
SPEECH_TIMEOUT_SECONDS=120
VOICE_START_TIMEOUT_SECONDS=10

# Knowledge review opens directly; this server-bound actor needs knowledge_review in AI service.
KNOWLEDGE_REVIEWER_ID=local-reviewer

# JWT key: generate with python -c 'import secrets; print(secrets.token_urlsafe(48))'
DEMO_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DEMO_JWT_MINUTES=60
# true on HTTPS; false only for localhost HTTP.
DEMO_COOKIE_SECURE=false
# Seed once with: PYTHONPATH=backend backend/.venv/bin/python -m app.seed_demo_users
# Choose two existing BTC profiles with distinct, non-shared channel identities.
DEMO_USER_1_USERNAME=demo1
DEMO_USER_1_PASSWORD=replace-with-a-strong-password
DEMO_USER_1_CUSTOMER_ID=replace-with-existing-btc-customer-id-1
DEMO_USER_2_USERNAME=demo2
DEMO_USER_2_PASSWORD=replace-with-another-strong-password
DEMO_USER_2_CUSTOMER_ID=replace-with-existing-btc-customer-id-2
