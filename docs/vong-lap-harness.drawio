        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-9-0" value="&lt;b&gt;Commit / dấu vết&lt;/b&gt;">
          <mxGeometry x="60" y="952" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-9-1" value="Memory MCP ghi runtime.turns cùng nội dung đã giao, bằng chứng và kết quả nghiệp vụ. Log theo lượt và công cụ, có thể bật Langfuse.">
          <mxGeometry x="295" y="952" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-9-2" value="Chặn ghi khi bộ nhớ đang bị khóa do xóa dữ liệu. LangMem dành cho khách đã định danh. Tín hiệu Knowledge phụ thuộc cấu hình.">
