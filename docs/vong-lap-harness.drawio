  <diagram id="harness-report" name="Bảng báo cáo">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1664" pageHeight="1152" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="background" value="" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#F4F8FB;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="24" y="24" width="1616" height="1104" as="geometry" />
        </mxCell>
        <mxCell id="header" value="&lt;b style=&quot;font-size:28px&quot;&gt;Bảng báo cáo  /  Kiểm soát theo bước&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#D9EAF5&quot;&gt;Đối chiếu mã nguồn hiện tại  ·  Đường dẫn tính từ ai-services/  ·  Các hạn mức bên dưới là giá trị mặc định&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=22;spacingRight=22;fontFamily=Helvetica;fontSize=15;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="48" y="44" width="1568" height="76" as="geometry" />
        </mxCell>
        <object id="jump-flow" label="&lt;b&gt;Vòng lặp Harness ↗&lt;/b&gt;" link="data:page/id,harness-loop">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=12;fontColor=#153450;fillColor=#EAF3F9;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
            <mxGeometry x="1228" y="67" width="175" height="31" as="geometry" />
          </mxCell>
        </object>
        <object id="jump-loops" label="&lt;b&gt;Các luồng liên quan ↗&lt;/b&gt;" link="data:page/id,harness-related">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=12;fontColor=#153450;fillColor=#EAF3F9;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
            <mxGeometry x="1414" y="67" width="175" height="31" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="col-0" value="&lt;b&gt;Bước và thành phần&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="235" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col-1" value="&lt;b&gt;Xử lý và đầu ra&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="145" width="472" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col-2" value="&lt;b&gt;Điều kiện / nhánh lỗi&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="145" width="414" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col-3" value="&lt;b&gt;Nguồn đối chiếu&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="145" width="423" height="42" as="geometry" />
        </mxCell>
        <mxCell id="row-0-0" value="&lt;b&gt;Tiếp nhận và khóa phiên&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="187" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-0-1" value="Backend gọi /v1/chat/turns hoặc /v1/chat/turns/stream. API xác thực nội bộ, runtime khóa theo session_id và đặt deadline 90 giây." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="187" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-0-2" value="Dành tối đa 3 giây trong deadline để cố lưu bằng chứng khi timeout. Voice gửi bản chép lời từ backend." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="187" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-0-3" value="app/api/chat.py:44&lt;br/&gt;app/agent/harness/runtime.py:338" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="187" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-1-0" value="&lt;b&gt;Định danh / Replay&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="272" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-1-1" value="Tra CRM theo định danh kênh hoặc đối chiếu thông tin đã xác minh. Trạng thái known, unknown hay ambiguous. Kiểm cặp session_id + client_msg_id và hash yêu cầu." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="272" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-1-2" value="Khớp và có câu đã lưu → phát lại. Yêu cầu lệch → 409 ở HTTP. Có thao tác đã ghi mà thiếu câu → turn_recovery_required." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="272" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-1-3" value="app/agent/harness/session_identity.py:54&lt;br/&gt;app/agent/harness/runtime.py:380&lt;br/&gt;app/mcp_servers/mcp_memory/services/replay.py:4" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="272" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-2-0" value="&lt;b&gt;accept / retrieve_context&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="357" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-2-1" value="Che PII, tách ngữ cảnh giao hàng, đọc bộ nhớ đúng phạm vi. Mặc định tối đa 6 lượt gần nhất đưa vào prompt, tuổi hồ sơ 240 ngày." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="357" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-2-2" value="Có dữ liệu phù hợp mới dựng Call Brief. Có thể tra lại báo giá và tồn kho ở đầu phiên. Giới hạn ngữ cảnh 70.000 ký tự JSON." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="357" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-2-3" value="app/agent/graph.py:15&lt;br/&gt;app/agent/harness/session_nodes.py:28&lt;br/&gt;app/agent/harness/context.py:136" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="357" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-3-0" value="&lt;b&gt;run_agent / Deep Agent&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="442" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-3-1" value="Model nhận lời khách, bằng chứng và 12 công cụ nghiệp vụ. Kết quả, từ chối hoặc lỗi công cụ quay lại model trong cùng node." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="442" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-3-2" value="8 lần gọi nghiệp vụ và 16 lần thử mặc định. Đọc độc lập có thể chạy song song. Hai hạn mức này áp dụng cho BusinessTools." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="442" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-3-3" value="app/agent/harness/agent_nodes.py:150&lt;br/&gt;app/agent/implementations/business_agent.py:326&lt;br/&gt;app/agent/implementations/tool_names.py" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="442" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-4-0" value="&lt;b&gt;Tiền kiểm thao tác ghi&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="527" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-4-1" value="Kiểm ngữ cảnh đầy đủ, sở hữu và bằng chứng theo thao tác. Tạo đơn đơn giản đủ điều kiện có thể duyệt nhanh bằng quy tắc, còn lại dùng duyệt có cấu trúc." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="527" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-4-2" value="Thiếu quyền, thiếu nguồn hoặc bộ duyệt ghi lỗi → từ chối. Quyền ghi ràng theo yêu cầu hiện tại và tham số chuẩn hóa." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="527" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-4-3" value="app/agent/harness/authorization.py:107&lt;br/&gt;app/agent/implementations/business_agent.py:474" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="527" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-5-0" value="&lt;b&gt;MCP / Bằng chứng&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="612" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-5-1" value="Gateway đặt deadline 10 giây cho kết nối và gọi MCP. Ghi nghiệp vụ dùng khóa ổn định và ngữ cảnh đã ký. Tra chính sách dùng release đã ghim trong lượt." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="612" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-5-2" value="Order MCP xác minh quyền đã ký trước giao dịch. Quyền có hiệu lực 120 giây. Biên nhận hợp lệ xác nhận thao tác, còn preview đổi/trả là ước tính." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="612" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-5-3" value="app/agent/mcp/gateway.py:55&lt;br/&gt;app/mcp_servers/mcp_order/write_authorization.py:75&lt;br/&gt;app/mcp_servers/mcp_knowledge/services/knowledge.py:64" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="612" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-6-0" value="&lt;b&gt;verify / Kiểm trước khi phát&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="697" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-6-1" value="Mặc định kiểm bằng chứng về sản phẩm, giá, tồn kho, chính sách và biên nhận. Duyệt ngữ nghĩa được áp dụng theo cấu hình và loại câu." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="697" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-6-2" value="Khi review ngữ nghĩa không khả dụng, mã hiện tại có thể chấp nhận bản đã đạt kiểm tra bằng quy tắc. Từ chối ngữ nghĩa dẫn tới nhánh phục hồi." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="697" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-6-3" value="app/agent/harness/agent_nodes.py:232&lt;br/&gt;app/agent/guardrails/checks.py&lt;br/&gt;app/agent/guardrails/semantic_grounding.py" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="697" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-7-0" value="&lt;b&gt;Khôi phục trong verify&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="782" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-7-1" value="Theo loại lỗi, chỉnh ngày giao từ bằng chứng, tiếp tục agent tối đa một lần khi còn ngân sách, hoặc tra bổ sung. Tối đa một lần sửa chỉ sinh câu." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="782" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-7-2" value="Kiểm lại sau phục hồi. Câu dự phòng cần qua kiểm tra và đủ điều kiện sử dụng. Hết đường phục hồi → reply_error." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="782" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-7-3" value="app/agent/harness/agent_nodes.py:282&lt;br/&gt;app/agent/harness/agent_nodes.py:494&lt;br/&gt;app/agent/factory.py:24" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="782" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-8-0" value="&lt;b&gt;Giao text / voice&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="867" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-8-1" value="Text qua GuardedStream chỉ phát câu cuối đã duyệt. Voice chờ dấu nhận played_chars để commit đúng phần đã phát." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="867" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-8-2" value="Voice quá 300 giây hoặc có lượt mới trước khi xác nhận → ghi 0 ký tự. Khi lỗi, runtime cố giữ bằng chứng và phần đã giao nếu có." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="867" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-8-3" value="app/agent/harness/streaming.py:63&lt;br/&gt;app/agent/harness/runtime.py:129&lt;br/&gt;app/agent/harness/runtime.py:380" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="867" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-9-0" value="&lt;b&gt;Commit / dấu vết&lt;/b&gt;" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#153450;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="952" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-9-1" value="Memory MCP ghi runtime.turns cùng nội dung đã giao, bằng chứng và kết quả nghiệp vụ. Log theo lượt và công cụ, có thể bật Langfuse." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="295" y="952" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-9-2" value="Chặn ghi khi bộ nhớ đang bị khóa do xóa dữ liệu. LangMem dành cho khách đã định danh. Tín hiệu Knowledge phụ thuộc cấu hình." style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="767" y="952" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell id="row-9-3" value="app/agent/harness/agent_nodes.py:517&lt;br/&gt;app/mcp_servers/mcp_memory/services/memory.py:361&lt;br/&gt;app/agent/harness/tracing.py" style="rounded=0;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=13;spacingRight=13;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=#EDF4F9;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1181" y="952" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell id="report-foot" value="Tài liệu mô tả luồng theo cấu hình mặc định trong mã. Các cờ verify, authorizer và semantic review có thể thay đổi hành vi." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=15;spacingRight=15;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7EFF6;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1057" width="1544" height="51" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
