        <mxCell id="title" value="&lt;b style=&quot;font-size:19px;color:#0F172A;&quot;&gt;TeleSale SudoCode 2026 — Sơ đồ Vòng lặp Harness&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Luồng xử lý một lượt hội thoại trong AgentHarnessRuntime và 4 node LangGraph (accept → retrieve_context → run_agent → verify)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;" vertex="1" parent="1">
