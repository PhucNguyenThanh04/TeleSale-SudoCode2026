        <mxCell id="lane-sources-1" value="app/knowledge/events/worker.py:26  ·  app/knowledge/services/publish.py:67  ·  app/knowledge/services/releases.py:47" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=8;spacingRight=8;fontFamily=Helvetica;fontSize=12;fontColor=#496578;fillColor=none;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
