        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-8-0" value="&lt;b&gt;Giao text / voice&lt;/b&gt;">
          <mxGeometry x="60" y="867" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-8-1" value="Text qua GuardedStream chỉ phát câu cuối đã duyệt. Voice chờ dấu nhận played_chars để commit đúng phần đã phát.">
          <mxGeometry x="295" y="867" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-8-2" value="Voice quá 300 giây hoặc có lượt mới trước khi xác nhận → ghi 0 ký tự. Khi lỗi, runtime cố giữ bằng chứng và phần đã giao nếu có.">
          <mxGeometry x="767" y="867" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-8-3" value="app/agent/harness/streaming.py:63&lt;br/&gt;app/agent/harness/runtime.py:129&lt;br/&gt;app/agent/harness/runtime.py:380">
