        <mxCell id="lane-0-1" value="&lt;b style=&quot;font-size:16px;color:#0F6E63&quot;&gt;Worker LangMem&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Xếp việc cho khách đã định danh. Kiểm lượt nguồn, chủ sở hữu, phiên bản và dấu xóa." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="748" y="165" width="400" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-0-2" value="&lt;b style=&quot;font-size:16px;color:#0F6E63&quot;&gt;Facts và episodes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Ghi vào LangMem/PostgreSQL. Lượt sau nạp hồ sơ đúng phạm vi và dựng Call Brief khi phù hợp." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
