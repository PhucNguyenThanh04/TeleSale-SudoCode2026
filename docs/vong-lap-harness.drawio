        <mxCell id="lane-title-1" value="&lt;b&gt;Knowledge Gap Loop&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=17;fontColor=#8C4A18;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
