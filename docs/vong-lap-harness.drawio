        <mxCell id="tag-repair" value="Chưa đạt" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;fontFamily=Helvetica;fontSize=12;fontColor=#8C4A18;fillColor=#F4F8FB;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
