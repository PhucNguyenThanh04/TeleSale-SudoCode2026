  <diagram id="harness-loop" name="Vòng lặp Harness">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1664" pageHeight="954" math="0" shadow="0">
