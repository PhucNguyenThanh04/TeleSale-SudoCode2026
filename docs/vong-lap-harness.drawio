        <object id="jump-loops" label="&lt;b&gt;Các luồng liên quan ↗&lt;/b&gt;" link="data:page/id,harness-related">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=12;fontColor=#153450;fillColor=#EAF3F9;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
            <mxGeometry x="1414" y="67" width="175" height="31" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Nhận lượt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;API + AgentHarnessRuntime&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Xác thực backend, khóa theo phiên. Giới hạn mặc định 90 giây cho toàn lượt." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="64" y="155" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Định danh và replay&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;Runtime · CRM · Memory MCP&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Ràng buộc danh tính theo kênh. Đối chiếu yêu cầu gửi lại với cache hoặc lượt đã lưu." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="452" y="155" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Che thông tin cá nhân&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;LangGraph · accept&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Che PII trong lời khách và tách ngữ cảnh giao hàng riêng. Khởi tạo trạng thái lượt." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="840" y="155" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Nạp ngữ cảnh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;LangGraph · retrieve_context&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Đọc lịch sử, hồ sơ và các lần tư vấn. Dựng Call Brief khi có dữ liệu của khách quay lại." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1228" y="155" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="replay" value="&lt;b&gt;Replay hoặc dừng trước graph&lt;/b&gt;&lt;br/&gt;Khớp và có câu đã lưu → trả lại. Lệch → báo xung đột. Đã ghi nghiệp vụ mà thiếu câu → yêu cầu khôi phục." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=13;fontColor=#8C4A18;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="452" y="306" width="318" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Chọn bước tiếp theo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;LangGraph · run_agent / Deep Agent&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Từ lời khách và bằng chứng, model đề xuất công cụ hoặc tạo bản nháp trả lời." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1228" y="410" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Tiền kiểm công cụ&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;BusinessTools&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Kiểm tham số, sở hữu và hạn mức. Thao tác ghi cần đủ bằng chứng và quyền từ lượt hiện tại." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="840" y="410" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Gọi công cụ MCP&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;Catalog · Order · Knowledge&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Trả dữ liệu, lỗi hoặc biên nhận. Order xác minh quyền ghi và khóa chống trùng trước giao dịch." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="452" y="410" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b style=&quot;font-size:18px;color:#153450&quot;&gt;Kiểm tra bản nháp&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#153450&quot;&gt;LangGraph · verify&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Đối chiếu các khẳng định và kết quả nghiệp vụ với nguồn. Duyệt ngữ nghĩa theo cấu hình." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1228" y="660" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="repair" value="&lt;b style=&quot;font-size:18px;color:#8C4A18&quot;&gt;Khôi phục có giới hạn&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#8C4A18&quot;&gt;Bên trong node verify&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Khi phù hợp, tiếp tục agent một lần hoặc tra bổ sung. Sửa lời tối đa một lần rồi kiểm lại." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="840" y="660" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="deliver" value="&lt;b style=&quot;font-size:18px;color:#0F6E63&quot;&gt;Giao câu trả lời&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#0F6E63&quot;&gt;Runtime · Text / Voice&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Text phát câu đã duyệt. Voice gửi câu cho backend phát TTS và chờ số ký tự đã phát." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="452" y="660" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="persist" value="&lt;b style=&quot;font-size:18px;color:#0F6E63&quot;&gt;Lưu lượt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#0F6E63&quot;&gt;Runtime · Memory MCP&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Lưu lời khách đã che, phần đã giao và bằng chứng vào PostgreSQL. Lượt sau đọc lại trạng thái." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="64" y="660" width="318" height="124" as="geometry" />
        </mxCell>
        <mxCell id="failed" value="&lt;b&gt;Báo lỗi lượt&lt;/b&gt;&lt;br/&gt;Cố lưu bằng chứng và phần đã phát nếu có." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=13;fontColor=#9A3C47;fillColor=#FCEEF0;strokeColor=#D9A6AD;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1228" y="836" width="318" height="54" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Vòng công cụ&lt;/b&gt; ↺ mặc định 8 lượt gọi nghiệp vụ và 16 lần đề xuất/thử được tính vào ngân sách.&lt;br/&gt;&lt;b&gt;Nét đứt&lt;/b&gt; biểu thị nhánh từ chối, gửi lại, khôi phục có điều kiện hoặc lượt khách tiếp theo." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=16;spacingRight=16;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7EFF6;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
