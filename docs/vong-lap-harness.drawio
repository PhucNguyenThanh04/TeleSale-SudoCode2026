        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-0-0" value="&lt;b&gt;Tiếp nhận và khóa phiên&lt;/b&gt;">
          <mxGeometry x="60" y="187" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-0-1" value="Backend gọi /v1/chat/turns hoặc /v1/chat/turns/stream. API xác thực nội bộ, runtime khóa theo session_id và đặt deadline 90 giây.">
          <mxGeometry x="295" y="187" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-0-2" value="Dành tối đa 3 giây trong deadline để cố lưu bằng chứng khi timeout. Voice gửi bản chép lời từ backend.">
          <mxGeometry x="767" y="187" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-0-3" value="app/api/chat.py:44&lt;br/&gt;app/agent/harness/runtime.py:338">
          <mxGeometry x="1181" y="187" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-1-0" value="&lt;b&gt;Định danh / Replay&lt;/b&gt;">
          <mxGeometry x="60" y="272" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-1-1" value="Tra CRM theo định danh kênh hoặc đối chiếu thông tin đã xác minh. Trạng thái known, unknown hay ambiguous. Kiểm cặp session_id + client_msg_id và hash yêu cầu.">
          <mxGeometry x="295" y="272" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-1-2" value="Khớp và có câu đã lưu → phát lại. Yêu cầu lệch → 409 ở HTTP. Có thao tác đã ghi mà thiếu câu → turn_recovery_required.">
          <mxGeometry x="767" y="272" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-1-3" value="app/agent/harness/session_identity.py:54&lt;br/&gt;app/agent/harness/runtime.py:380&lt;br/&gt;app/mcp_servers/mcp_memory/services/replay.py:4">
          <mxGeometry x="1181" y="272" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-2-0" value="&lt;b&gt;accept / retrieve_context&lt;/b&gt;">
          <mxGeometry x="60" y="357" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-2-1" value="Che PII, tách ngữ cảnh giao hàng, đọc bộ nhớ đúng phạm vi. Mặc định tối đa 6 lượt gần nhất đưa vào prompt, tuổi hồ sơ 240 ngày.">
          <mxGeometry x="295" y="357" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-2-2" value="Có dữ liệu phù hợp mới dựng Call Brief. Có thể tra lại báo giá và tồn kho ở đầu phiên. Giới hạn ngữ cảnh 70.000 ký tự JSON.">
          <mxGeometry x="767" y="357" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-2-3" value="app/agent/graph.py:15&lt;br/&gt;app/agent/harness/session_nodes.py:28&lt;br/&gt;app/agent/harness/context.py:136">
          <mxGeometry x="1181" y="357" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-3-0" value="&lt;b&gt;run_agent / Deep Agent&lt;/b&gt;">
          <mxGeometry x="60" y="442" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-3-1" value="Model nhận lời khách, bằng chứng và 12 công cụ nghiệp vụ. Kết quả, từ chối hoặc lỗi công cụ quay lại model trong cùng node.">
          <mxGeometry x="295" y="442" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-3-2" value="8 lần gọi nghiệp vụ và 16 lần thử mặc định. Đọc độc lập có thể chạy song song. Hai hạn mức này áp dụng cho BusinessTools.">
          <mxGeometry x="767" y="442" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-3-3" value="app/agent/harness/agent_nodes.py:150&lt;br/&gt;app/agent/implementations/business_agent.py:326&lt;br/&gt;app/agent/implementations/tool_names.py">
          <mxGeometry x="1181" y="442" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-4-0" value="&lt;b&gt;Tiền kiểm thao tác ghi&lt;/b&gt;">
          <mxGeometry x="60" y="527" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-4-1" value="Kiểm ngữ cảnh đầy đủ, sở hữu và bằng chứng theo thao tác. Tạo đơn đơn giản đủ điều kiện có thể duyệt nhanh bằng quy tắc, còn lại dùng duyệt có cấu trúc.">
          <mxGeometry x="295" y="527" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-4-2" value="Thiếu quyền, thiếu nguồn hoặc bộ duyệt ghi lỗi → từ chối. Quyền ghi ràng theo yêu cầu hiện tại và tham số chuẩn hóa.">
          <mxGeometry x="767" y="527" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-4-3" value="app/agent/harness/authorization.py:107&lt;br/&gt;app/agent/implementations/business_agent.py:474">
          <mxGeometry x="1181" y="527" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-5-0" value="&lt;b&gt;MCP / Bằng chứng&lt;/b&gt;">
          <mxGeometry x="60" y="612" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-5-1" value="Gateway đặt deadline 10 giây cho kết nối và gọi MCP. Ghi nghiệp vụ dùng khóa ổn định và ngữ cảnh đã ký. Tra chính sách dùng release đã ghim trong lượt.">
          <mxGeometry x="295" y="612" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-5-2" value="Order MCP xác minh quyền đã ký trước giao dịch. Quyền có hiệu lực 120 giây. Biên nhận hợp lệ xác nhận thao tác, còn preview đổi/trả là ước tính.">
          <mxGeometry x="767" y="612" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-5-3" value="app/agent/mcp/gateway.py:55&lt;br/&gt;app/mcp_servers/mcp_order/write_authorization.py:75&lt;br/&gt;app/mcp_servers/mcp_knowledge/services/knowledge.py:64">
          <mxGeometry x="1181" y="612" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-6-0" value="&lt;b&gt;verify / Kiểm trước khi phát&lt;/b&gt;">
          <mxGeometry x="60" y="697" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-6-1" value="Mặc định kiểm bằng chứng về sản phẩm, giá, tồn kho, chính sách và biên nhận. Duyệt ngữ nghĩa được áp dụng theo cấu hình và loại câu.">
          <mxGeometry x="295" y="697" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-6-2" value="Khi review ngữ nghĩa không khả dụng, mã hiện tại có thể chấp nhận bản đã đạt kiểm tra bằng quy tắc. Từ chối ngữ nghĩa dẫn tới nhánh phục hồi.">
          <mxGeometry x="767" y="697" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#ffffff;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-6-3" value="app/agent/harness/agent_nodes.py:232&lt;br/&gt;app/agent/guardrails/checks.py&lt;br/&gt;app/agent/guardrails/semantic_grounding.py">
          <mxGeometry x="1181" y="697" width="423" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#182b49;fontSize=14;" id="row-7-0" value="&lt;b&gt;Khôi phục trong verify&lt;/b&gt;">
          <mxGeometry x="60" y="782" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-7-1" value="Theo loại lỗi, chỉnh ngày giao từ bằng chứng, tiếp tục agent tối đa một lần khi còn ngân sách, hoặc tra bổ sung. Tối đa một lần sửa chỉ sinh câu.">
          <mxGeometry x="295" y="782" width="472" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=14;" id="row-7-2" value="Kiểm lại sau phục hồi. Câu dự phòng cần qua kiểm tra và đủ điều kiện sử dụng. Hết đường phục hồi → reply_error.">
          <mxGeometry x="767" y="782" width="414" height="85" as="geometry" />
        </mxCell>
        <mxCell parent="1" vertex="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI,Helvetica;align=left;spacingLeft=13;spacingRight=13;fillColor=#f3f7fd;strokeColor=#d1ddee;fontColor=#425675;fontSize=12;" id="row-7-3" value="app/agent/harness/agent_nodes.py:282&lt;br/&gt;app/agent/harness/agent_nodes.py:494&lt;br/&gt;app/agent/factory.py:24">
