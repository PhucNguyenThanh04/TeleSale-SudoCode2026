        <mxCell id="header" value="&lt;b style=&quot;font-size:28px&quot;&gt;Agent Harness  /  Vòng lặp xử lý mỗi lượt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#D9EAF5&quot;&gt;TeleSale SudoCode 2026  ·  AI FastAPI tiếp nhận văn bản từ chat hoặc bản chép lời cuối của cuộc gọi&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=22;spacingRight=22;fontFamily=Helvetica;fontSize=15;fontColor=#FFFFFF;fillColor=#153450;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="48" y="44" width="1568" height="76" as="geometry" />
        </mxCell>
        <object id="jump-report" label="&lt;b&gt;Bảng báo cáo ↗&lt;/b&gt;" link="data:page/id,harness-report">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=12;fontColor=#153450;fillColor=#EAF3F9;strokeColor=none;strokeWidth=1.2;" vertex="1" parent="1">
