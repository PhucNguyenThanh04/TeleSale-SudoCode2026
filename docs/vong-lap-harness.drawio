        </mxCell>
        <mxCell id="lane-1-0" value="&lt;b style=&quot;font-size:16px;color:#8C4A18&quot;&gt;Tín hiệu được bật&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Lượt thiếu bằng chứng, phản hồi và kết quả đánh giá có thể tạo tín hiệu từ runtime hoặc runner." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="320" y="385" width="400" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-1-1" value="&lt;b style=&quot;font-size:16px;color:#8C4A18&quot;&gt;Worker + người duyệt&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Phân loại gap, đề xuất bản nháp có nguồn. Duyệt nội dung và kiểm tra trước phát hành." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="748" y="385" width="400" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-1-2" value="&lt;b style=&quot;font-size:16px;color:#8C4A18&quot;&gt;Release chính sách&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Kích hoạt release để policy.search tra bằng chỉ mục Qdrant và nguồn PostgreSQL. Ghim release trong lượt." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFF2DE;strokeColor=#E2BD87;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1176" y="385" width="400" height="112" as="geometry" />
        </mxCell>
