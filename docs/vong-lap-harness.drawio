        <mxCell id="lane-2" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#FFFFFF;strokeColor=#C6D6E2;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="60" y="587" width="1544" height="202" as="geometry" />
        </mxCell>
        <mxCell id="lane-title-2" value="&lt;b&gt;Harness đánh giá&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=17;fontColor=#285476;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="78" y="605" width="218" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-2-0" value="&lt;b style=&quot;font-size:16px;color:#285476&quot;&gt;Kịch bản và preflight&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Nạp kịch bản cùng điều kiện chạy. Cặp Full / Baseline có cùng dữ liệu đầu vào và release." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="320" y="605" width="400" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-2-1" value="&lt;b style=&quot;font-size:16px;color:#285476&quot;&gt;Cùng runtime&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Runner chạy hội thoại nhiều lượt và thu trace. Baseline bỏ bộ nhớ từ phiên trước." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="748" y="605" width="400" height="112" as="geometry" />
        </mxCell>
        <mxCell id="lane-2-2" value="&lt;b style=&quot;font-size:16px;color:#285476&quot;&gt;Trích xuất và chấm&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Trace → câu hỏi, mệnh đề và kết quả → scorer hoặc bộ chấm BTC. rag_eval đánh giá riêng việc truy xuất và sinh câu trả lời." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#EBF4FB;strokeColor=#A0BFD7;strokeWidth=1.2;" vertex="1" parent="1">
