        <mxCell id="lane-0-0" value="&lt;b style=&quot;font-size:16px;color:#0F6E63&quot;&gt;runtime.turns&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Commit lượt và bằng chứng. Hội thoại đã ghi có thể đọc lại khi worker đang chờ." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=14;fontColor=#233E54;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
