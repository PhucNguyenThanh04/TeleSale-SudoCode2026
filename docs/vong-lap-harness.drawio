        <mxCell id="lane-title-0" value="&lt;b&gt;Bộ nhớ khách hàng&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=14;spacingRight=14;fontFamily=Helvetica;fontSize=17;fontColor=#0F6E63;fillColor=#E7F5F0;strokeColor=#9BCDBD;strokeWidth=1.2;" vertex="1" parent="1">
